{
  "$schema": "./schema/patterns.schema.json",
  "description": "Machine-checkable tells of AI-generated interfaces. Used by `unslop lint` and rendered into the playbook. Every pattern carries examples that the checks run against it.",
  "patterns": [
    {
      "id": "banned-phrase",
      "severity": "error",
      "scope": "copy",
      "phrases": [
        "Unlock the power of",
        "Supercharge",
        "Seamless",
        "Revolutionize",
        "Revolutionise",
        "Next-generation",
        "Next-gen",
        "Elevate your",
        "In today's fast-paced world",
        "Cutting-edge",
        "Game-changer",
        "Game-changing",
        "Unleash",
        "Empower",
        "Effortless",
        "Streamline your",
        "World-class",
        "Harness the",
        "Take your business to the next level",
        "Transform the way you",
        "Built for the future",
        "Like never before"
      ],
      "message": "\"{match}\" is a phrase that signals generated copy.",
      "fix": "Say what the product does and for whom, with a concrete detail (a number, a feature name, a result).",
      "examples": {
        "bad": ["<h1>Supercharge your workflow</h1>", "<p>Seamlessly sync your files.</p>"],
        "good": ["<h1>Invoices that chase themselves</h1>", "<SeamlessScroll />"]
      }
    },
    {
      "id": "vague-social-proof",
      "severity": "warn",
      "scope": "copy",
      "regex": "\\b(?:trusted by|loved by|join) (?:thousands|millions|leading|teams|developers|the best)\\b",
      "message": "Vague social proof (\"{match}\") reads as filler.",
      "fix": "Use a specific, checkable claim: \"2,400 clinics send reminders with Pulsebook\", or a named quote.",
      "examples": {
        "bad": ["<p>Trusted by thousands of teams</p>", "Join millions of creators"],
        "good": ["<p>Used by 2,400 dental clinics in Ontario</p>"]
      }
    },
    {
      "id": "placeholder-copy",
      "severity": "error",
      "scope": "copy",
      "regex": "\\blorem ipsum\\b|\\bFeature [1-9]\\b|\\b(?:Your|Company|Product) (?:Name|Logo) Here\\b|\\bJohn Doe\\b|\\bAcme (?:Inc|Corp)\\b",
      "message": "Placeholder content (\"{match}\").",
      "fix": "Write real-looking content: a named product, believable numbers, real feature names.",
      "examples": {
        "bad": ["<p>Lorem ipsum dolor sit amet</p>", "<h3>Feature 1</h3>", "<cite>John Doe, CEO</cite>"],
        "good": ["<h3>Overdue reminders</h3>"]
      }
    },
    {
      "id": "vague-button",
      "severity": "warn",
      "scope": "copy",
      "regex": ">\\s*(?:Get started|Learn more|Click here|Read more|Discover more|Explore)\\s*<",
      "message": "Button or link text that doesn't say what happens.",
      "fix": "Name the outcome: \"Start 14-day trial\", \"See pricing\", \"Book a 20-minute call\".",
      "examples": {
        "bad": ["<button>Get started</button>", "<a href=\"/docs\">Learn more</a>"],
        "good": ["<button>Start 14-day trial</button>", "<p>Get started in minutes, not weeks.</p>"]
      }
    },
    {
      "id": "emoji-heading",
      "severity": "warn",
      "scope": "copy",
      "regex": "<h[1-6][^>]*>\\s*(?:\\p{Extended_Pictographic}|\\p{Regional_Indicator})",
      "flags": "giu",
      "message": "Heading starts with an emoji, a common stand-in for a real icon or idea.",
      "fix": "Drop the emoji, or use one icon from the project's icon set with a consistent size and stroke.",
      "examples": {
        "bad": ["<h3>🚀 Fast deploys</h3>", "<h2 class=\"title\">✨ New</h2>"],
        "good": ["<h3>Deploys in 40 seconds</h3>"]
      }
    },
    {
      "id": "purple-blue-gradient",
      "severity": "error",
      "scope": "style",
      "regex": "\\bfrom-(?:purple|violet|indigo|fuchsia)-\\d{2,3}\\b[^\"'`\\n]*\\bto-(?:blue|indigo|purple|violet|pink|cyan|sky)-\\d{2,3}\\b|(?:linear|radial|conic)-gradient\\([^;]*?(?:purple|violet|indigo|#667eea|#764ba2|#8b5cf6|#7c3aed|#6366f1|#a855f7|#4f46e5)",
      "message": "Purple/indigo gradient, the most recognised default of generated interfaces.",
      "fix": "Use a neutral base and one accent chosen from the product. If you need depth, use a subtle tint of that accent.",
      "examples": {
        "bad": [
          "<div class=\"bg-gradient-to-r from-purple-600 to-blue-500\">",
          "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);",
          "background-image: radial-gradient(circle, violet, transparent);"
        ],
        "good": ["<div class=\"bg-stone-50\">", "background: linear-gradient(#fafaf9, #f5f5f4);"]
      }
    },
    {
      "id": "default-indigo-accent",
      "severity": "warn",
      "scope": "style",
      "regex": "\\b(?:bg|text|ring|border)-(?:indigo|violet)-(?:500|600)\\b",
      "max": 2,
      "message": "The framework's default indigo/violet accent is used throughout.",
      "fix": "Pick an accent from the product or brand, define it as a token (e.g. --accent), and use it only for what matters.",
      "examples": {
        "bad": ["<a class=\"bg-indigo-600\"></a><b class=\"text-indigo-600\"></b><i class=\"ring-indigo-500\"></i>"],
        "good": ["<a class=\"bg-accent\"></a>"]
      }
    },
    {
      "id": "gradient-text",
      "severity": "warn",
      "scope": "style",
      "regex": "\\bbg-clip-text\\b|background-clip\\s*:\\s*text",
      "max": 1,
      "message": "Gradient text used more than once in this file.",
      "fix": "Use weight and size for emphasis. Keep gradient text to one moment, if any.",
      "examples": {
        "bad": ["<h1 class=\"bg-clip-text\"></h1><h2 class=\"bg-clip-text\"></h2>"],
        "good": ["<h1 class=\"bg-clip-text\"></h1>"]
      }
    },
    {
      "id": "neon-glow",
      "severity": "warn",
      "scope": "style",
      "regex": "\\bshadow-(?:purple|violet|indigo|fuchsia|cyan|pink|blue)-\\d{3}(?:\\/\\d+)?\\b|drop-shadow-\\[0_0_|box-shadow\\s*:[^;]*\\b0(?:px)? 0(?:px)? \\d{2,}px[^;]*(?:#(?!000)[0-9a-f]{3,8}|rgba?\\((?!\\s*0\\s*,\\s*0\\s*,\\s*0)|hsla?\\(|purple|violet|cyan|magenta)",
      "message": "Coloured glow shadow, a signature of generated dark-mode pages.",
      "fix": "Use a soft neutral shadow for elevation, or none. Show focus with an outline, not a glow.",
      "examples": {
        "bad": ["<div class=\"shadow-purple-500/50\">", "box-shadow: 0 0 40px rgba(139, 92, 246, 0.6);"],
        "good": ["box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);", "<div class=\"shadow-sm\">"]
      }
    },
    {
      "id": "glassmorphism",
      "severity": "warn",
      "scope": "style",
      "regex": "\\bbackdrop-blur(?:-[a-z0-9]+)?\\b|backdrop-filter\\s*:\\s*blur",
      "max": 1,
      "message": "Frosted-glass blur on several surfaces in this file.",
      "fix": "Keep blur for one overlay that needs it (a sticky header over content). Use solid surfaces elsewhere.",
      "examples": {
        "bad": ["<nav class=\"backdrop-blur-md\"></nav><div class=\"backdrop-blur-lg\"></div>"],
        "good": ["<nav class=\"backdrop-blur-md\"></nav>"]
      }
    },
    {
      "id": "decorative-motion",
      "severity": "warn",
      "scope": "style",
      "regex": "\\banimate-(?:blob|float|floating|shimmer|glow|gradient|aurora|orbit)\\b|@keyframes\\s+(?:blob|float|floating|shimmer|glow|gradient|aurora|orbit)\\b",
      "message": "Decorative looping motion with no job.",
      "fix": "Remove it, or replace it with motion that explains something: a value updating, a list receiving an item.",
      "examples": {
        "bad": ["<div class=\"animate-blob\"></div>", "@keyframes float { to { transform: translateY(-8px) } }"],
        "good": ["<div class=\"animate-spin\"></div>"]
      }
    },
    {
      "id": "animate-layout",
      "severity": "warn",
      "scope": "style",
      "regex": "\\btransition-all\\b|transition(?:-property)?\\s*:\\s*(?:all|width|height|top|left|right|bottom|margin|padding)\\b",
      "message": "Transition on layout properties or `all`.",
      "fix": "Animate only transform, opacity and filter, and name the properties you transition.",
      "examples": {
        "bad": ["<button class=\"transition-all\">", "transition: all 0.3s ease;", "transition: height 200ms;"],
        "good": ["transition: transform 200ms ease-out, opacity 200ms ease-out;"]
      }
    },
    {
      "id": "css-motion-without-reduced",
      "severity": "error",
      "scope": "style",
      "regex": "@keyframes\\b|\\banimation\\s*:",
      "unless": "prefers-reduced-motion",
      "once": true,
      "message": "Animation with no `prefers-reduced-motion` handling in this file.",
      "fix": "Add `@media (prefers-reduced-motion: reduce)` with a complete still state.",
      "examples": {
        "bad": ["@keyframes in { from { opacity: 0 } }"],
        "good": [
          "@keyframes in { from { opacity: 0 } } @media (prefers-reduced-motion: reduce) { * { animation: none } }"
        ]
      }
    },
    {
      "id": "tailwind-motion-without-reduced",
      "severity": "warn",
      "scope": "markup",
      "regex": "\\banimate-(?!none\\b)[a-z][a-z0-9-]*",
      "unless": "motion-reduce:|motion-safe:|prefers-reduced-motion|useReducedMotion|reducedMotion",
      "once": true,
      "message": "Tailwind animation with no reduced-motion variant in this file.",
      "fix": "Use `motion-safe:animate-…` or add `motion-reduce:animate-none`.",
      "examples": {
        "bad": ["<div class=\"animate-bounce\"></div>"],
        "good": ["<div class=\"motion-safe:animate-bounce\"></div>"]
      }
    },
    {
      "id": "default-font",
      "severity": "warn",
      "scope": "style",
      "regex": "font-family\\s*:\\s*['\"]?Inter\\b|\\bfamily=Inter\\b|import\\s*\\{[^}]*\\bInter\\b[^}]*\\}\\s*from\\s*['\"]next/font/google['\"]",
      "message": "Inter: the font nearly every generated interface uses by default.",
      "fix": "Choose a typeface for a reason that fits the product, and set a type scale for it. Keep Inter only if you chose it on purpose.",
      "examples": {
        "bad": ["font-family: Inter, sans-serif;", "import { Inter } from \"next/font/google\";"],
        "good": ["font-family: \"Source Serif 4\", serif;", "font-family: Interstate, sans-serif;"]
      }
    },
    {
      "id": "focus-removed",
      "severity": "error",
      "scope": "style",
      "regex": "outline\\s*:\\s*(?:none|0)\\s*(?:!important)?\\s*;(?![^}]*box-shadow)|(?<![^\"'`\\s]*focus(?:-visible)?:[^\"'`]*)\\boutline-none\\b(?![^\"'`]*focus(?:-visible)?:)",
      "message": "Focus outline removed with no visible replacement nearby.",
      "fix": "Keep a visible focus state: `:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }`.",
      "examples": {
        "bad": [
          "button:focus { outline: none; }",
          "<input class=\"outline-none\">",
          "<input class=\"ring-2 outline-none\">"
        ],
        "good": [
          "<input class=\"outline-none focus-visible:ring-2\">",
          "a:focus { outline: none; box-shadow: 0 0 0 2px; }",
          "<button class=\"focus-visible:ring-2 outline-none\">"
        ]
      }
    },
    {
      "id": "img-without-alt",
      "severity": "error",
      "scope": "markup",
      "regex": "<img\\b(?![^>]*\\balt\\s*=)[^>]*>",
      "message": "Image without alt text.",
      "fix": "Add alt text that says what the image shows, or alt=\"\" if it is purely decorative.",
      "examples": {
        "bad": ["<img src=\"/hero.png\">", "<img\n  src=\"/a.png\"\n/>"],
        "good": ["<img src=\"/hero.png\" alt=\"Invoice list with three overdue items\">"]
      }
    },
    {
      "id": "clickable-div",
      "severity": "warn",
      "scope": "markup",
      "regex": "<(?:div|span)\\b[^>]*\\bon[Cc]lick\\s*=",
      "message": "Click handler on a div or span, which keyboards and screen readers can't use.",
      "fix": "Use a <button> for actions and an <a href> for navigation.",
      "examples": {
        "bad": ["<div onClick={open}>", "<span onclick=\"go()\">"],
        "good": ["<button onClick={open}>"]
      }
    },
    {
      "id": "dead-link",
      "severity": "warn",
      "scope": "markup",
      "regex": "\\bhref\\s*=\\s*[\"']#[\"']",
      "message": "Link that goes nowhere (href=\"#\").",
      "fix": "Link to a real destination, or use a <button> if it performs an action.",
      "examples": {
        "bad": ["<a href=\"#\">Pricing</a>"],
        "good": ["<a href=\"#pricing\">Pricing</a>"]
      }
    }
  ]
}
