{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deliverwebsite/unslop/blob/main/schema/libraries.schema.json",
  "title": "Unslop library index",
  "type": "object",
  "required": ["description", "updated", "libraries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "bestFor", "kind", "useFor"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "github": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          },
          "bestFor": {
            "type": "string",
            "minLength": 10,
            "maxLength": 120
          },
          "kind": {
            "enum": ["foundation", "effects", "marketplace", "sections", "components", "templates", "dashboards"]
          },
          "useFor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
